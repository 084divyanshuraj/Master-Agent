# ==============================================================================
# Vignan's University — Master Agent Portal Environment Configuration
# ==============================================================================

# Groq API Keys (Comma-separated or individual keys)
# Add 1 to 5 keys here for round-robin load balancing and 429 rate limit protection
GROQ_API_KEYS=gsk_your_first_groq_key_here,gsk_your_second_groq_key_here

# Groq Models (OpenAI OSS Fast & Synthesis models)
GROQ_MODEL_FAST=openai/gpt-oss-20b
GROQ_MODEL_SYNTHESIS=openai/gpt-oss-120b

# MongoDB Connection URI (Leave blank to use internal in-memory logger fallback)
# Example: mongodb+srv://username:password@cluster.mongodb.net/vignan_master_agent
MONGODB_URI=

# Server Configuration
PORT=8000
HOST=0.0.0.0
